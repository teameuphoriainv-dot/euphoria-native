# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
#
# `.env*.local` alone left a real gap: a plain `.env` was NOT ignored, so the first person to
# follow the usual convention and put live keys in `.env` would have committed them. Verified with
# `git check-ignore .env` before the fix — it matched nothing. `.env.example` stays TRACKED on
# purpose: it is the template, and every value in it is empty.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Reference media (local only — analysis in refs/*.md)
refs/videos/
refs/images/

# Agent / tooling local state (never commit — churns every run)
.claude-flow/
.impeccable/
.gstack/

# logs
*.log
logs/

# In-App Purchase private keys (.p8). NEVER commit these — Apple serves each exactly once.
.secrets/
*.p8

# Screen-audit captures. The SCRIPT and the FINDINGS are tracked; 26 PNGs at ~1MB each are not --
# they are regenerable by `scripts/capture-screens.sh` and would add ~20MB per audit run.
refs/audit/**/*.png

# Python bytecode from the audit lanes in scripts/ — build output, never source.
__pycache__/
*.pyc

# Goldie renders upload-ready App Store media here. Config and replay flows are source;
# captures are deterministic build artifacts and would add large binary churn to git.
goldie/out/
