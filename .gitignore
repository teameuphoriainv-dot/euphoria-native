# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Reference media (local only — analysis in refs/*.md)
refs/videos/
refs/images/

# Agent / tooling local state (never commit — churns every run)
.claude-flow/
.impeccable/
.gstack/

# logs
*.log
logs/

# In-App Purchase private keys (.p8). NEVER commit these — Apple serves each exactly once.
.secrets/
*.p8
