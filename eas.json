{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "uploadSourceMaps": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://euphoria-native.expo.app"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://euphoria-native.expo.app"
      },
      "node": "24.14.1",
      "channel": "production"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./.secrets/AuthKey_793R5AM7NG.p8",
