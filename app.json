{
  "expo": {
    "name": "euphoria-native",
    "slug": "euphoria-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "euphorianative",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/euphoria.icon",
      "bundleIdentifier": "com.euphoriainv.euphoria",
      "appleTeamId": "9SS423KXF5",
      "backgroundColor": "#09090D",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.euphoriainv.euphoria",
          "group.com.euphoriainv.euphoria"
        ]
      },
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "CFBundleDisplayName": "Euphoria",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.euphoria.native"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@bacons/apple-targets",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1091301249021-jnq84r4gigho6r35725o9e55r9vi219m"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#09090D",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.euphoriainv.euphoria.widget",
                  "targetName": "EuphoriaWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.euphoriainv.euphoria"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "8a6dba4a-e52a-4c04-b359-7244670431b1"
      }
    },
    "owner": "s-k-28",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a6dba4a-e52a-4c04-b359-7244670431b1"
    }
  }
}
